# Copy to config.env and edit. Sourced by scripts/install.sh and scripts/verify.sh.
#
# These are every value that is specific to a particular org, host, or NAS.
# If you are recreating this setup somewhere else, these are the ONLY things
# that should need changing — everything else in the manifests is deliberate
# and explained in docs/findings.md.
#
# config.env is gitignored. The App private key is NEVER committed.

# ---------------------------------------------------------------- GitHub
# Org the runners register to. Runners are org-level, not per-repo.
GITHUB_ORG=ergonlabs
GITHUB_CONFIG_URL=https://github.com/ergonlabs

# GitHub App (see docs/prerequisites.md for how to create it).
# The App needs:  Repository: Actions read, Metadata read
#                 Organization: Self-hosted runners READ AND WRITE
GITHUB_APP_ID=4582063
GITHUB_APP_INSTALLATION_ID=153458266

# Path to the App private key on the host. NOT in this repo. chmod 600.
GITHUB_APP_PRIVATE_KEY=/home/stefanrusek/gh.pem

# ---------------------------------------------------------------- Scale set
# Two pools since 2026-08-20 — see 20-scale-set.yaml / 21-scale-set-small.yaml
# for the why and the sizing math. RUNNER_MIN/RUNNER_MAX below are
# informational only (install.sh/verify.sh don't template them into the
# manifests — actual min/maxRunners live as literals in each manifest's
# valuesContent); keep them in sync by hand if you resize a pool.
#
# Large pool: full dind+buildkit sidecars, for jobs that build Docker images
# or run kind (e.g. sugarmaple-app's e2e-tests). Workflows use
# `runs-on: $RUNNER_SCALE_SET_NAME`.
RUNNER_SCALE_SET_NAME=ergonlabs-k8s
RUNNER_MIN=0
RUNNER_MAX=3

# Small pool: runner container only, no Docker at all. For jobs that never
# touch Docker (lint/typecheck/test/build). Workflows use
# `runs-on: $RUNNER_SCALE_SET_NAME_SMALL`.
RUNNER_SCALE_SET_NAME_SMALL=ergonlabs-k8s-small
RUNNER_MIN_SMALL=0
RUNNER_MAX_SMALL=50

# ---------------------------------------------------------------- Versions
# Controller and scale-set charts MUST be the same version.
ARC_CHART_VERSION=0.14.2
CACHE_SERVER_CHART_VERSION=1.1.3

# Runner image. Date-tagged, never :latest, so pods don't change underneath you.
RUNNER_IMAGE_REPO=localhost:5001/ergonlabs/actions-runner
RUNNER_IMAGE_TAG=2026-08-14b

# ---------------------------------------------------------------- Storage
# Block device mount for engine stores AND job workspaces.
# MUST be a real block filesystem — see docs/findings.md #1 (overlayfs on NFS).
ARC_BLOCK_MOUNT=/mnt/arc-block

# iSCSI portal (the NAS). Used by host/setup-iscsi.sh.
ISCSI_PORTAL=10.100.0.5

# ---------------------------------------------------------------- Cluster
KUBECONFIG=/etc/rancher/k3s/k3s.yaml
# Docker is a snap on this host; its binaries are not on the default PATH.
DOCKER_BIN=/snap/bin/docker
